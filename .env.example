# Настройки автотестов. Переменные окружения имеют приоритет над .env.
API_BASE_URL=http://localhost:8001
API_TIMEOUT=100

# Тестовые данные для загрузки файлов.
TEST_DATA.IMAGE_PNG_FILE=./testdata/files/image.png

# Порт Docker-стенда должен совпадать с портом в API_BASE_URL.
API_PORT=8001

# Swagger Coverage. Адрес спецификации должен соответствовать API_BASE_URL.
SWAGGER_COVERAGE_SERVICES='[{"key":"api-course","name":"API Course","tags":["API","COURSES"],"repository":"https://github.com/Nikita-Filonov/qa-automation-engineer-api-course","swagger_url":"http://localhost:8001/openapi.json"}]'
SWAGGER_COVERAGE_RESULTS_DIR=./coverage-results
SWAGGER_COVERAGE_HISTORY_FILE=./coverage-history.json
SWAGGER_COVERAGE_HISTORY_RETENTION_LIMIT=30
SWAGGER_COVERAGE_HTML_REPORT_FILE=./coverage.html
SWAGGER_COVERAGE_JSON_REPORT_FILE=./coverage-report.json
